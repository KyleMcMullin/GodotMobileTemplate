[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://menus/screens/delete_data_confirmation.gd" id="1"]

[node name="Deletemydata" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 32
theme_override_constants/margin_top = 48
theme_override_constants/margin_right = 32
theme_override_constants/margin_bottom = 48

[node name="Scroll" type="ScrollContainer" parent="Margin"]
layout_mode = 2
horizontal_scroll_mode = 0

[node name="Rows" type="VBoxContainer" parent="Margin/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 20

[node name="Title" type="Label" parent="Margin/Scroll/Rows"]
layout_mode = 2
theme_override_font_sizes/font_size = 32
text = "Delete my data"
autowrap_mode = 2

[node name="Explanation" type="Label" parent="Margin/Scroll/Rows"]
unique_name_in_owner = true
layout_mode = 2
text = "Delete this device's settings and analytics identifier? Your purchase and age-group setting are kept. The app will close, and setup will appear next time. If signed in, deletion of known cloud saves is also requested. This cannot be undone."
autowrap_mode = 2

[node name="ConfirmButton" type="Button" parent="Margin/Scroll/Rows"]
unique_name_in_owner = true
layout_mode = 2
text = "Delete data and close"
custom_minimum_size = Vector2(0, 56)

[node name="BackButton" type="Button" parent="Margin/Scroll/Rows"]
layout_mode = 2
custom_minimum_size = Vector2(0, 56)
text = "Back"

[connection signal="pressed" from="Margin/Scroll/Rows/ConfirmButton" to="." method="_on_confirm_pressed"]

[connection signal="pressed" from="Margin/Scroll/Rows/BackButton" to="." method="_on_back_pressed"]
